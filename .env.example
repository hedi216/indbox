# Examples only: never copy over the existing production environment.
# Supply local credentials for development; preserve these existing secrets in production.
DATABASE_URL=
JWT_SECRET=
PORT=4000
CLIENT_ORIGIN=https://indbox.tn
PUBLIC_URL=https://indbox.tn
# Development default. Production keeps NODE_ENV=production and existing PORT/TRUST_PROXY.
NODE_ENV=development
TRUST_PROXY=0
SEED_ADMIN_EMAIL=admin@indbox.local
SEED_ADMIN_PASSWORD=
# Sending requires explicit activation and a fixed UTC cutoff. See DEPLOYMENT.md.
MAIL_DELIVERY_ENABLED=false
MAIL_DELIVERY_NOT_BEFORE=
# MailEnable Standard, local-only relay on the Contabo VM (no authentication).
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IN-D-BOX <no-reply@indbox.tn>"
# Planned reply address: verify mailbox or forwarding before activation.
MAIL_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=

# Operational alert threshold in sale units (including lots).
LOW_STOCK_THRESHOLD=5
