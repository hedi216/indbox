generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 ADMIN
 MANAGER
 CUSTOMER
}
enum OrderStatus {
 NEW
 CONFIRMED
 IN_PREPARATION
 READY
 SHIPPED
 DELIVERED
 CANCELLED
}
enum QuoteStatus {
 NEW
 REVIEWING
 CONTACTED
 QUOTED
 ACCEPTED
 REJECTED
 CLOSED
}
enum DiscountType {
 PERCENTAGE
 FIXED
}
enum MessageStatus {
 NEW
 READ
 ARCHIVED
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 name String
 role Role @default(CUSTOMER)
 active Boolean @default(true)
 tokenVersion Int @default(0)
 customer Customer?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
model Customer {
 id String @id @default(cuid())
 userId String? @unique
 user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
 firstName String
 lastName String
 email String @unique
 phone String
 company String?
 addresses Address[]
 orders Order[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([lastName, firstName])
}
model Address {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields:[customerId], references:[id], onDelete:Cascade)
 street String
 city String
 country String @default("Tunisie")
 @@index([customerId])
}
model Category {
 id String @id @default(cuid())
 name String
 slug String @unique
 description String @default("")
 image String?
 active Boolean @default(true)
 featured Boolean @default(false)
 displayOrder Int @default(0)
 seoTitle String @default("")
 seoDescription String @default("")
 parentId String?
 parent Category? @relation("CategoryTree",fields:[parentId],references:[id],onDelete:Restrict)
 children Category[] @relation("CategoryTree")
 products Product[]
 promotions Promotion[] @relation("PromotionCategories")
 quoteItems QuoteRequestItem[]
 @@index([active, displayOrder])
}
model Product {
 id String @id @default(cuid())
 name String
 slug String @unique
 sku String @unique
 shortDescription String @default("")
 description String @default("")
 categoryId String
 category Category @relation(fields:[categoryId], references:[id], onDelete:Restrict)
 price Decimal @db.Decimal(12,3)
 active Boolean @default(true)
 featured Boolean @default(false)
 isNew Boolean @default(false)
 trackStock Boolean @default(true)
 stock Int @default(0)
 minimumQuantity Int @default(1)
 orderUnit String @default("UNIT")
 quantityPerLot Int @default(1)
 seoTitle String @default("")
 seoDescription String @default("")
 specifications Json @default("{}")
 tags String[]
 images ProductImage[]
 variants ProductVariant[]
 related Product[] @relation("RelatedProducts")
 relatedTo Product[] @relation("RelatedProducts")
 promotions Promotion[] @relation("PromotionProducts")
 orderItems OrderItem[]
 quoteItems QuoteRequestItem[]
 movements InventoryMovement[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([categoryId,active])
 @@index([featured,isNew])
 @@index([name])
 @@index([tags],type:Gin)
}
model ProductImage {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
 url String
 alt String @default("")
 displayOrder Int @default(0)
 @@index([productId,displayOrder])
}
model ProductVariant {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
 name String
 sku String @unique
 price Decimal @db.Decimal(12,3)
 compareAtPrice Decimal? @db.Decimal(12,3)
 stock Int @default(0)
 size String @default("")
 dimensions String @default("")
 color String @default("")
 material String @default("")
 minimumQuantity Int @default(1)
 quantityPerLot Int @default(1)
 active Boolean @default(true)
 orderItems OrderItem[]
 movements InventoryMovement[]
 @@index([productId,active])
}
model Order {
 id String @id @default(cuid())
 number String @unique
 sequence Int @unique @default(autoincrement())
 idempotencyKey String @unique
 customerId String
 customer Customer @relation(fields:[customerId], references:[id],onDelete:Restrict)
 status OrderStatus @default(NEW)
 email String
 firstName String
 lastName String
 phone String
 company String?
 address String
 city String
 notes String @default("")
 subtotal Decimal @db.Decimal(12,3)
 promotionDiscount Decimal @db.Decimal(12,3)
 couponDiscount Decimal @db.Decimal(12,3)
 total Decimal @db.Decimal(12,3)
 couponId String?
 coupon Coupon? @relation(fields:[couponId], references:[id],onDelete:SetNull)
 couponCode String?
 items OrderItem[]
 history OrderStatusHistory[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([status,createdAt])
 @@index([customerId,createdAt])
 @@index([email])
}
model OrderItem {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
 productId String?
 product Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
 variantId String?
 variant ProductVariant? @relation(fields:[variantId],references:[id],onDelete:SetNull)
 productName String
 variantName String?
 sku String
 image String?
 characteristics Json @default("{}")
 quantity Int
 orderUnit String
 quantityPerLot Int
 regularPrice Decimal @db.Decimal(12,3)
 unitPrice Decimal @db.Decimal(12,3)
 total Decimal @db.Decimal(12,3)
 @@index([orderId])
}
model OrderStatusHistory {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
 status OrderStatus
 note String @default("")
 actor String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([orderId,createdAt])
}
model Coupon {
 id String @id @default(cuid())
 code String @unique
 type DiscountType
 value Decimal @db.Decimal(12,3)
 startsAt DateTime @db.Timestamptz(3)
 endsAt DateTime @db.Timestamptz(3)
 active Boolean @default(true)
 minimumOrder Decimal @default(0) @db.Decimal(12,3)
 usageLimit Int?
 usageCount Int @default(0)
 perCustomerLimit Int?
 orders Order[]
 @@index([active,startsAt,endsAt])
}
model Promotion {
 id String @id @default(cuid())
 name String
 type DiscountType
 value Decimal @db.Decimal(12,3)
 startsAt DateTime @db.Timestamptz(3)
 endsAt DateTime @db.Timestamptz(3)
 active Boolean @default(true)
 global Boolean @default(false)
 products Product[] @relation("PromotionProducts")
 categories Category[] @relation("PromotionCategories")
 @@index([active,startsAt,endsAt])
}
model QuoteRequest {
 id String @id @default(cuid())
 number String @unique
 sequence Int @unique @default(autoincrement())
 name String
 company String?
 phone String
 email String
 desiredDeliveryDate DateTime? @db.Timestamptz(3)
 notes String @default("")
 files String[]
 status QuoteStatus @default(NEW)
 adminNotes String @default("")
 items QuoteRequestItem[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([status,createdAt])
}
model QuoteRequestItem {
 id String @id @default(cuid())
 quoteId String
 quote QuoteRequest @relation(fields:[quoteId],references:[id],onDelete:Cascade)
 productId String?
 product Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
 categoryId String?
 category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 packagingType String
 quantity Int
 dimensions String @default("")
 material String @default("")
 printing String @default("")
 colors String @default("")
 @@index([quoteId])
}
model SiteSetting {
 key String @id
 value Json
}
model Service {
 id String @id @default(cuid())
 title String
 description String
 image String?
 icon String @default("Package")
 displayOrder Int @default(0)
 active Boolean @default(true)
 @@index([active,displayOrder])
}
model ContactMessage {
 id String @id @default(cuid())
 name String
 email String
 phone String @default("")
 subject String
 message String
 status MessageStatus @default(NEW)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([status,createdAt])
}
model InventoryMovement {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
 variantId String?
 variant ProductVariant? @relation(fields:[variantId],references:[id],onDelete:SetNull)
 quantity Int
 reason String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([productId,createdAt])
}
model AuditLog {
 id String @id @default(cuid())
 userId String
 action String
 entity String
 entityId String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([entity,entityId])
}
model Cart {
 id String @id @default(uuid())
 items Json @default("[]")
 couponCode String @default("")
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model EmailNotification {
 id String @id @default(cuid())
 to String
 subject String
 html String
 text String
 event String
 reference String
 status String @default("PENDING")
 attempts Int @default(0)
 lastError String?
 nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
 sentAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([event,reference,to])
 @@index([status,nextAttemptAt])
}
